{
  "Version": "1",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["ots:GetRow", "ots:PutRow"],
      "Resource": [
        "acs:ots:cn-hangzhou:<ACCOUNT_ID>:instance/dcdv-accounts/table/dcdv_users",
        "acs:ots:cn-hangzhou:<ACCOUNT_ID>:instance/dcdv-accounts/table/dcdv_progress",
        "acs:ots:cn-hangzhou:<ACCOUNT_ID>:instance/dcdv-accounts/table/dcdv_ephemeral",
        "acs:ots:cn-hangzhou:<ACCOUNT_ID>:instance/dcdv-accounts/table/dcdv_classes",
        "acs:ots:cn-hangzhou:<ACCOUNT_ID>:instance/dcdv-accounts/table/dcdv_class_members"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["ots:GetRange"],
      "Resource": [
        "acs:ots:cn-hangzhou:<ACCOUNT_ID>:instance/dcdv-accounts/table/dcdv_classes",
        "acs:ots:cn-hangzhou:<ACCOUNT_ID>:instance/dcdv-accounts/table/dcdv_class_members"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["ots:DeleteRow"],
      "Resource": ["acs:ots:cn-hangzhou:<ACCOUNT_ID>:instance/dcdv-accounts/table/dcdv_ephemeral"]
    }
  ]
}
